<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ROMs\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Pokes\pokes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Spectrum128kEmulator.Core\Spectrum128kEmulator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="tmp\**\*.cs" />
    <Compile Remove="Spectrum128kEmulator.Tests\**\*.cs" />
    <Compile Remove="Spectrum128kEmulator.Windows.Tests\**\*.cs" />
    <Compile Remove="Spectrum128kEmulator.ManualHarness\**\*.cs" />
	<Compile Remove="Spectrum128kEmulator.Z80Compliance\**\*.cs" />
    <Compile Remove="Spectrum128kEmulator.Core\**\*.cs" />
    <EmbeddedResource Remove="obj\**\*" />
    <EmbeddedResource Remove="bin\**\*" />
    <EmbeddedResource Remove="tmp\**\*" />
    <None Remove="obj\**\*" />
    <None Remove="bin\**\*" />
    <None Remove="tmp\**\*" />
    <EmbeddedResource Remove="Spectrum128kEmulator.Tests\**\*" />
    <EmbeddedResource Remove="Spectrum128kEmulator.Windows.Tests\**\*" />
    <EmbeddedResource Remove="Spectrum128kEmulator.ManualHarness\**\*" />
	<EmbeddedResource Remove="Spectrum128kEmulator.Z80Compliance\**\*" />
	<EmbeddedResource Remove="Spectrum128kEmulator.Core\**\*" />
    <None Remove="Spectrum128kEmulator.Tests\**\*" />
    <None Remove="Spectrum128kEmulator.Windows.Tests\**\*" />
    <None Remove="Spectrum128kEmulator.ManualHarness\**\*" />
	<None Remove="Spectrum128kEmulator.Z80Compliance\**\*" />
	<None Remove="Spectrum128kEmulator.Core\**\*" />
  </ItemGroup>

</Project>
